#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Home Assistant loads custom integrations from <config>/custom_components,
# importing them as `custom_components.<domain>`. Link the directory in rather
# than putting it on PYTHONPATH: this integration's package is named
# `ecowitt_modbus`, the same as the library it depends on, so exposing it as a
# top-level module would shadow the real dependency and fail at import.
ln -sfn "${PWD}/custom_components" "${PWD}/config/custom_components"

hass --config "${PWD}/config" --debug
